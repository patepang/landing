engine-strict=true
save-exact=true
# 14 days in minutes: no package (direct or transitive) younger than this enters the lockfile.
minimum-release-age=20160
# Security exception, 22 Oct 2026: next <=16.4.0 is affected by GHSA-2464-fhr4-w9xw (critical),
# GHSA-673q-mjm6-r5xr (critical) and GHSA-p3m5-59mp-jv5r (high); the first fixed release, 16.4.1,
# is younger than 14 days. Only next and the two package families it pins exactly (@next/env and the
# @next/swc-* compiler binaries) are exempt; next itself stays pinned exactly. Remove these lines
# once the pinned next is older than 14 days.
minimum-release-age-exclude[]=next
minimum-release-age-exclude[]=@next/env
minimum-release-age-exclude[]=@next/swc-*
